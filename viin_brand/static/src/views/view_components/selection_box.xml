<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- Tags the selection box so selection_box.scss can tint the whole native selection container
       (the "N selected" count and the bulk ActionMenus, its siblings in o_selection_container) as
       one brand bar. Only a hook class is added. -->
  <t t-inherit="web.SelectionBox" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_selection_box')]" position="attributes">
      <attribute name="class" add="o_viin_selection_bar" separator=" "/>
    </xpath>
  </t>

</templates>

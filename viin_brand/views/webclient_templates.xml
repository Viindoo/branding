<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<!-- Default title and favicon of every page web.layout renders and whose caller sets none, such as
	     the portal pages. The variables are set after the first <meta>, so a website's layout keeps
	     its own title and favicon; neither <title> nor the typed icon link is located. -->
	<template id="web_layout" inherit_id="web.layout" name="Viindoo Web layout">
		<xpath expr="//head/meta[1]" position="after">
			<t t-set="title" t-value="title or 'Viindoo'"/>
			<t t-set="x_icon" t-value="x_icon or '/viin_brand/static/img/favicon.ico'"/>
		</xpath>
	</template>

	<template id="brand_promotion_message" inherit_id="web.brand_promotion_message" name="Viindoo Brand Promotion Message">
		<xpath expr="//t[@t-set='odoo_logo']//a" position="attributes">
			<attribute name="t-attf-href">https://viindoo.com?utm_source=db&amp;utm_medium=#{_utm_medium}</attribute>
		</xpath>
		<xpath expr="//t[@t-set='odoo_logo']//a" position="replace" mode="inner">Viindoo</xpath>
	</template>

	<template id="login_layout" inherit_id="web.login_layout">
		<xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']/span" position="attributes">
			<attribute name="style">display:none</attribute>
		</xpath>
		<xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']/span" position="after">
			<span>Viindoo</span>
		</xpath>
		<xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']" position="attributes">
			<attribute name="href">https://viindoo.com?utm_source=db&amp;utm_medium=auth</attribute>
		</xpath>
	</template>

	<!-- The Open Graph and Twitter card of the login page, which the web client link preview of a
	     shared /odoo URL reads. -->
	<template id="login" inherit_id="web.login">
		<xpath expr="//t[@t-set='head']" position="before">
			<t t-set="og_title" t-value="'Viindoo' if og_title == 'Odoo' else og_title"/>
			<t t-set="og_image_url" t-value="og_image_url and request.httprequest.url_root + 'viin_brand/static/img/viindoo_og_image.png'"/>
		</xpath>
		<xpath expr="//meta[@property='og:site_name']" position="attributes">
			<attribute name="content">Viindoo</attribute>
		</xpath>
		<xpath expr="//meta[@property='og:description']" position="attributes">
			<attribute name="content">Viindoo - one platform for all your business operations.</attribute>
		</xpath>
		<xpath expr="//meta[@property='og:image:alt']" position="attributes">
			<attribute name="content">Viindoo - one platform for all your business operations.</attribute>
		</xpath>
		<xpath expr="//meta[@property='og:image:width']" position="attributes">
			<attribute name="content">1200</attribute>
		</xpath>
		<xpath expr="//meta[@property='og:image:height']" position="attributes">
			<attribute name="content">630</attribute>
		</xpath>
		<!-- The handle comes from the company social link of tools.py, set by controllers/home.py. -->
		<xpath expr="//meta[@name='twitter:site']" position="attributes">
			<attribute name="t-att-content">twitter_handle</attribute>
		</xpath>
		<xpath expr="//meta[@name='twitter:description']" position="attributes">
			<attribute name="content">Viindoo - one platform for all your business operations.</attribute>
		</xpath>
		<xpath expr="//meta[@name='twitter:image:alt']" position="attributes">
			<attribute name="content">Viindoo - one platform for all your business operations.</attribute>
		</xpath>
	</template>

	<template id="webclient_offline">
		<t t-set="head">
			<script type="text/javascript">
				document.addEventListener("DOMContentLoaded", () =&gt; {
					const cookies = document.cookie.split(';').map(c =&gt; c.trim());
					if (cookies.includes('color_scheme=dark')) {
						document.body.style.backgroundColor = "#111B1E";
						document.body.style.color = "#EDF4F5";
					}
				});
				window.addEventListener('online', () =&gt; location.reload());
			</script>
			<style>
				body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, "Noto Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
				padding:0;
				margin:0;
				background-color: #fff;
				color: rgb(17, 24, 39);
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				height: 100vh;
				width: 100vw;
				user-select: none;
				}
				.card {
				width: 80%;
				}
				.card img {
				width: 96px;
				height: auto;
				filter: grayscale(.6);
				}
				.card button {
				background-color: #7F4282;
				color: #FFFFFF;
				border: 1px solid #7F4282;
				border-radius: .25rem;
				padding: .5rem 1rem;
				cursor: pointer;
				font-size: 1.2rem;
				font-weight: 500;
				}
			</style>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
		</t>
		<t t-call="web.layout"
			html_data="{'style': 'height: 100%;'}"
			title.translate="Offline"
			head="head">
			<div class="card">
				<img t-attf-src="data:image/png;base64,{{viindoo_icon.to_base64()}}" alt="Viindoo logo"/>
				<h1>You are offline</h1>
				<p>Check your network connection and come back here. Viindoo will load as soon as you're back online.</p>
				<button onclick="location.reload()">Check again</button>
			</div>
		</t>
	</template>

	<template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
		<xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
			<attribute name="href">/viin_brand/static/img/viindoo-icon-ios.png</attribute>
		</xpath>
		<xpath expr="//meta[@name='theme-color']" position="attributes">
			<attribute name="content">#007F8E</attribute>
		</xpath>
		<!-- Stamps Bootstrap's color mode on the html root from the server-resolved color_scheme before
		     any JS runs, so the first paint matches the scheme. -->
		<xpath expr="//t[@t-call='web.layout']" position="attributes">
			<attribute name="html_data">{'data-bs-theme': 'dark' if color_scheme == 'dark' else 'light'}</attribute>
		</xpath>
	</template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.viin_brand</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="viin_color_scheme"/>
            </xpath>
            <xpath expr="//div[@name='api_keys']/div[1]/span[hasclass('text-muted')]" position="after">
                <widget name="documentation_link"
                        path="https://viindoo.com/documentation/19.0/developer/development/integrate-with-third-party-resources.html"
                        label="Learn more"
                        icon="fa-fw o_button_icon fa-info-circle"/>
            </xpath>
        </field>
    </record>
</odoo>

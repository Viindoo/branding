<odoo>
    <data>
        <template id="brand_promotion"
            inherit_id="website_sale.brand_promotion">
            <xpath
                expr="//t[@t-call='web.brand_promotion_message']"
                position="replace">
                <t t-set="_message">
                    <!-- Label must not assert a "#1"/superiority ranking (VN advertising law). -->
                    <a target="_blank"
                        href="https://viindoo.com/intro/ecommerce?utm_source=db&amp;utm_medium=website">Open Source eCommerce Software</a>
                </t>
                <t t-call="web.brand_promotion_message" _message="_message" _utm_medium.f="website"/>
            </xpath>
        </template>
    </data>
</odoo>

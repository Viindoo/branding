<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_form" model="ir.ui.view">
        <field name="name">event.event.form.inherit.viin.brand</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='event_url']" position="attributes">
                <attribute name="placeholder">e.g. "https://www.example.com"</attribute>
            </xpath>
        </field>
    </record>

</odoo>

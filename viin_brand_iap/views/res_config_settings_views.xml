<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.viin.brand.iap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="iap.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iap_credits_setting']" position="attributes">
                <attribute name="string">In-App Purchase</attribute>
            </xpath>
        </field>
    </record>
</odoo>

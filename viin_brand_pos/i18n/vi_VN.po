"This sequence is automatically created by the system but you can change it "
"to customize the reference numbers of your orders lines."
msgstr "Thứ tự này được tạo tự động bởi hệ thống nhưng bạn có thể thay đổi nó để tùy chỉnh số tham chiếu của các dòng đơn hàng của bạn."

#. module: viin_brand_pos
#: model:ir.model.fields,help:viin_brand_pos.field_pos_config__sequence_id
msgid ""
"This sequence is automatically created by the system but you can change it "
"to customize the reference numbers of your orders."
msgstr "Trình tự này được tạo tự động bởi hệ thống nhưng bạn có thể thay đổi để tùy chỉnh số tham chiếu cho đơn hàng của bạn."
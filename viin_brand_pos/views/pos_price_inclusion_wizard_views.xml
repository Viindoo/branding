<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_price_inclusion_wizard_form" model="ir.ui.view">
        <field name="name">pos.price.inclusion.wizard.form.inherit.viin.brand.pos</field>
        <field name="model">pos.price.inclusion.wizard</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_price_inclusion_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/p" position="replace" mode="inner">
                Viindoo stores one price per product. How tax is applied to
                that price is not mathematically reversible so rounding
                creates permanent discrepancies.
            </xpath>
        </field>
    </record>
</odoo>

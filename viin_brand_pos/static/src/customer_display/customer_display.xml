<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <!-- Core's idle screen has no img tag, only the shared "pos-logo" div, whose image comes from
             the navbar-logo CSS custom property as in navbar.xml. -->
        <xpath expr="//div[hasclass('pos-logo')]" position="attributes">
            <attribute name="style">--navbar-logo: url('/viin_brand_pos/static/src/img/viindoo-logo.svg')</attribute>
        </xpath>
    </t>

</templates>

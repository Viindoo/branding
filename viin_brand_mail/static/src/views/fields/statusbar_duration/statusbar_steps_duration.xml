<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- `mail.StatusBarDurationField` and `mail.RottingStatusBarDurationField` are primary copies
       of `web.StatusBarField`, so an extension of the latter never reaches them; each is
       extended on its own. Only attributes are set, so the load order against viin_brand does
       not matter. -->
  <t t-inherit="mail.StatusBarDurationField" t-inherit-mode="extension">
    <xpath expr="//button[@role='radio']" position="attributes">
      <attribute name="class" add="o_viin_numbered_step" separator=" "/>
      <attribute name="t-att-data-viin-step">viinStepNumber(item)</attribute>
    </xpath>
  </t>

  <t t-inherit="mail.RottingStatusBarDurationField" t-inherit-mode="extension">
    <xpath expr="//button[@role='radio']" position="attributes">
      <attribute name="class" add="o_viin_numbered_step" separator=" "/>
      <attribute name="t-att-data-viin-step">viinStepNumber(item)</attribute>
    </xpath>
  </t>

</templates>

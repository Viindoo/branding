#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_delivery_slip
msgid ""
"If this checkbox is ticked, the system will automatically print the delivery"
" slip of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in phiếu giao hàng của phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_lot_labels
msgid ""
"If this checkbox is ticked, the system will automatically print the lot/SN "
"labels of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in nhãn số lô/sê-ri của phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_package_label
msgid ""
"If this checkbox is ticked, the system will automatically print the package "
"label when \"Put in Pack\" button is used."
msgstr "Nếu đánh dấu hộp kiểm này, hệ thống sẽ tự động in nhãn kiện hàng khi nút \"Đóng kiện\" được sử dụng."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_packages
msgid ""
"If this checkbox is ticked, the system will automatically print the packages"
" and their contents of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in các kiện hàng và thành phần của chúng trong phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_product_labels
msgid ""
"If this checkbox is ticked, the system will automatically print the product "
"labels of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in nhãn sản phẩm của phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_reception_report_labels
msgid ""
"If this checkbox is ticked, the system will automatically print the "
"reception report labels of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in nhãn báo cáo nhập kho của phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_reception_report
msgid ""
"If this checkbox is ticked, the system will automatically print the "
"reception report of a picking when it is validated and has assigned moves."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in báo cáo nhập kho của phiếu kho khi phiếu kho được xác nhận và có dịch chuyển đã giữ hàng."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_print_return_slip
msgid ""
"If this checkbox is ticked, the system will automatically print the return "
"slip of a picking when it is validated."
msgstr "Nếu đánh dấu ô này, hệ thống sẽ tự động in phiếu trả hàng của phiếu kho khi phiếu kho được xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_picking_type__auto_show_reception_report
msgid ""
"If this checkbox is ticked, the system will automatically show the reception"
" report (if there are moves to allocate to) when validating."
msgstr "Nếu đánh dấu hộp kiểm này, hệ thống sẽ tự động hiển thị báo cáo nhập kho (nếu có các dịch chuyển cần phân bổ) khi xác nhận."

#. module: viin_brand_stock
#: model:ir.model.fields,field_description:viin_brand_stock.field_stock_warehouse_orderpoint__product_max_qty
msgid "Max Quantity"
msgstr "Số lượng tối đa"

#. module: viin_brand_stock
#: model:ir.model.fields,field_description:viin_brand_stock.field_stock_warehouse_orderpoint__product_min_qty
msgid "Min Quantity"
msgstr "Số lượng tối thiểu"

#. module: viin_brand_stock
#: model:ir.model,name:viin_brand_stock.model_stock_warehouse_orderpoint
msgid "Minimum Inventory Rule"
msgstr "Quy tắc tồn kho tối thiểu"

#. module: viin_brand_stock
#: model:ir.model,name:viin_brand_stock.model_stock_picking_type
msgid "Picking Type"
msgstr "Loại nghiệp vụ"

#. module: viin_brand_stock
#: model:ir.model.fields,field_description:viin_brand_stock.field_stock_picking_type__auto_show_reception_report
msgid "Show Reception Report at Validation"
msgstr "Hiển thị báo cáo nhập kho khi xác nhận"

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_warehouse_orderpoint__product_min_qty
msgid ""
"When the virtual stock goes below the Min Quantity specified for this field,"
" the system generates a procurement to bring the forecasted quantity above "
"of this Min Quantity."
msgstr "Khi tồn kho ảo xuống dưới số lượng tối thiểu được chỉ định cho trường này, hệ thống sẽ tạo một yêu cầu cung ứng để đưa số lượng dự kiến lên trên số lượng tối thiểu này."

#. module: viin_brand_stock
#: model:ir.model.fields,help:viin_brand_stock.field_stock_warehouse_orderpoint__product_max_qty
msgid ""
"When the virtual stock goes below the Min Quantity, the system generates a "
"procurement to bring the forecasted quantity up to (or near to) the Max "
"Quantity specified for this field (or to Min Quantity, whichever is bigger)."
msgstr "Khi tồn kho ảo xuống dưới số lượng tối thiểu, hệ thống sẽ tạo một yêu cầu cung ứng để đưa số lượng dự kiến lên đến (hoặc gần đến) số lượng tối đa được chỉ định cho trường này (hoặc đến số lượng tối thiểu, tùy theo giá trị nào lớn hơn)."
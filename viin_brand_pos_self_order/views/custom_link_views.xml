<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_link_tree" model="ir.ui.view">
        <field name="name">custom.link.list.inherit.viin.brand</field>
        <field name="model">pos_self_order.custom_link</field>
        <field name="inherit_id" ref="pos_self_order.custom_link_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">mysite</attribute>
            </xpath>
            <xpath expr="//field[@name='url']" position="attributes">
                <attribute name="placeholder">https://example.com</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Core Dropdown/DropdownItem give keyboard navigation and focus management;
       role=menuitemradio + aria-checked expose the current choice to assistive tech. Every change
       is delegated to the ViinThemePlugin. -->
  <t t-name="viin_backend_theme.ViinAppearanceSystray">
    <div class="o_viin_appearance d-flex align-items-center">
      <Dropdown>
        <button type="button" class="o_viin_appearance_toggle btn"
                title="Appearance" aria-label="Appearance" aria-haspopup="menu">
          <i class="oi" data-icon="dark_mode" aria-hidden="true"/>
        </button>

        <t t-set-slot="content">
          <div class="o_viin_appearance_group" role="presentation">Theme</div>
          <DropdownItem t-foreach="this.schemes" t-as="opt" t-key="opt.value"
              class="{ 'o_viin_appearance_option': true, active: this.viinTheme.scheme() === opt.value, 'dropdown-item_active_noarrow': true }"
              onSelected="() => this.setScheme(opt.value)"
              attrs="{ role: 'menuitemradio', 'aria-checked': this.viinTheme.scheme() === opt.value ? 'true' : 'false' }">
            <span class="d-flex align-items-center w-100">
              <i class="oi me-2" t-att-data-icon="opt.icon" aria-hidden="true"/>
              <span t-out="opt.label"/>
              <i t-if="this.viinTheme.scheme() === opt.value" class="oi ms-auto" data-icon="check" aria-hidden="true"/>
            </span>
          </DropdownItem>

          <div role="separator" class="dropdown-divider"/>

          <div class="o_viin_appearance_group" role="presentation">Density</div>
          <DropdownItem t-foreach="this.densities" t-as="opt" t-key="opt.value"
              class="{ 'o_viin_appearance_option': true, active: this.viinTheme.density() === opt.value, 'dropdown-item_active_noarrow': true }"
              onSelected="() => this.setDensity(opt.value)"
              attrs="{ role: 'menuitemradio', 'aria-checked': this.viinTheme.density() === opt.value ? 'true' : 'false' }">
            <span class="d-flex align-items-center w-100">
              <i class="oi me-2" t-att-data-icon="opt.icon" aria-hidden="true"/>
              <span t-out="opt.label"/>
              <i t-if="this.viinTheme.density() === opt.value" class="oi ms-auto" data-icon="check" aria-hidden="true"/>
            </span>
          </DropdownItem>
        </t>
      </Dropdown>
    </div>
  </t>

</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- "Skip to main content" bypass-blocks link (WCAG 2.4.1), visually hidden until focused
       (skip_link.scss); activating it moves keyboard focus into the action region via
       WebClient.skipToMainContent (webclient_patch.js). -->
  <t t-inherit="web.WebClient" t-inherit-mode="extension">
    <xpath expr="//t[@t-if='!state.fullscreen']" position="before">
      <a href="#" class="o_viin_skip_link" t-on-click.prevent="() => this.skipToMainContent()">Skip to main content</a>
    </xpath>
  </t>

</templates>

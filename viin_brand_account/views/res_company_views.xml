<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_view_onboarding" model="ir.ui.view">
        <field name="name">res.company.form.view.onboarding.inherit.viin.brand</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.res_company_form_view_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="placeholder">e.g. https://viindoo.com</attribute>
            </xpath>
        </field>
    </record>
</odoo>

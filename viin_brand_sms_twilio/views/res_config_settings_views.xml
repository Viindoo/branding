<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.viin.brand.sms.twilio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sms_twilio.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sms_provider']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- sms_provider is always invisible: the Twilio block below is always shown, so the provider radio has nothing to switch. -->
            <xpath expr="//div[hasclass('content-group')][button[@name='action_open_sms_twilio_account_manage']]" position="attributes">
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="website.InstagramOption" t-inherit-mode="extension">
        <xpath expr="//BuilderRow" position="attributes">
            <attribute name="tooltip.translate">Your Instagram page must be public to be integrated into a Viindoo website.</attribute>
        </xpath>
    </t>

    <t t-inherit="website.MegaMenuOption" t-inherit-mode="extension">
        <xpath expr="//BuilderSelectItem[Image[contains(@src, 's_mega_menu_odoo_menu')]]" position="attributes">
            <attribute name="title.translate">Viindoo Menu</attribute>
        </xpath>
    </t>

    <t t-inherit="website.dialog.addFont" t-inherit-mode="extension">
        <xpath expr="//sup/a" position="replace">?</xpath>
    </t>

    <t t-inherit="website.s_website_form_field_option" t-inherit-mode="extension">
        <xpath expr="//BuilderRow[@label.translate='Max File Size']" position="attributes">
            <attribute name="tooltip.translate">Note that your server has its own upload limit, which will take precedence over this value</attribute>
        </xpath>
    </t>
</templates>

<odoo>
    <template id="show_website_info"
        inherit_id="website.show_website_info">
        <xpath expr="//h1/small" position="replace" mode="inner">
            Viindoo Version <t t-out="version.get('server_version')"/>
        </xpath>
        <xpath expr="//section/p[1]" position="replace">
            <p>
                Information about the <t t-out="res_company.name"/> instance of Viindoo, the <a class="o_translate_inline" target="_blank" href="https://viindoo.com">Open Source ERP</a>.
            </p>
        </xpath>
        <!-- Chart of account and l10n app -->
        <xpath expr="//div[@t-if='l10n']/dl/dt/a" position="attributes">
            <attribute name="t-att-href"/>
            <attribute name="href">https://viindoo.com/intro/accounting</attribute>
        </xpath>
    </template>

    <!-- The page title of /website/info falls back to the name of this wrapper view
         (website.layout reads main_object.name). -->
    <record id="website.website_info" model="ir.ui.view">
        <field name="name">Viindoo Information</field>
    </record>

    <template id="layout" name="Main layout" inherit_id="website.layout">
		<xpath expr="//meta[@name='generator']" position="attributes">
			<attribute name="content">Viindoo</attribute>
		</xpath>

        <!-- No x_icon override: an xpath on it matches website's own x_icon producer first and
             would stop a configured favicon from being served. The brand favicon is the default
             of the favicon field instead (models/website.py). -->

        <!-- The apps button links straight to the backend; its sibling dropdown menu stays as
             core renders it. -->
        <xpath expr="//a[hasclass('o_frontend_to_backend_apps_btn')]" position="attributes">
            <attribute name="title">Go to your Viindoo Apps</attribute>
            <attribute name="data-bs-toggle"/>
            <attribute name="href">/odoo</attribute>
        </xpath>
    </template>

    <!-- Cookie table: cells are addressed by position, as their text is translated before views are merged. -->
    <template id="cookie_policy" inherit_id="website.cookie_policy">
        <xpath expr="//tbody/tr[1]/td[3]" position="replace" mode="inner">
            session_id (Viindoo)<br/>
        </xpath>
        <xpath expr="//tbody/tr[2]/td[3]" position="replace" mode="inner">
            frontend_lang (Viindoo)<br/>
            tz (Viindoo)
        </xpath>
        <xpath expr="//tbody/tr[3]/td[3]" position="replace" mode="inner">
            im_livechat_previous_operator (Viindoo)<br/>
            utm_campaign (Viindoo)<br/>
            utm_source (Viindoo)<br/>
            utm_medium (Viindoo)
        </xpath>
    </template>
</odoo>

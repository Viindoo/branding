<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The call-to-action snippets carry sample copy of the customer's own website: neutral, no product claim. -->
    <template id="s_call_to_action" inherit_id="website.s_call_to_action">
        <xpath expr="//h2" position="replace" mode="inner">
            Join the companies that grow their business with us.
        </xpath>
    </template>

    <template id="s_cta_box" inherit_id="website.s_cta_box">
        <xpath expr="//h2" position="replace" mode="inner">
            Join the companies that grow <br/>their business with us.
        </xpath>
    </template>

    <template id="s_cta_card" inherit_id="website.s_cta_card">
        <xpath expr="//h2" position="replace" mode="inner">
            Join the companies <br class="d-none d-lg-inline"/>that grow their business with us.
        </xpath>
    </template>

    <template id="s_cta_mockups" inherit_id="website.s_cta_mockups">
        <xpath expr="//h2" position="replace" mode="inner">
            Trusted by companies like yours.
        </xpath>
    </template>

    <template id="s_form_aside" inherit_id="website.s_form_aside">
        <xpath expr="//p[hasclass('lead')]" position="replace" mode="inner">
            Chat with us through or fill in this form to get information about anything related to our apps, services, and company.
        </xpath>
    </template>

    <template id="s_table_of_content" inherit_id="website.s_table_of_content">
        <xpath expr="(//h3)[last()]/following-sibling::p[1]" position="replace" mode="inner">
            Design templates easily with clean HTML and Bootstrap CSS. These templates offer a responsive, mobile-first design with SEO-ready markup.
        </xpath>
    </template>

    <template id="s_cta_mobile" inherit_id="website.s_cta_mobile">
        <xpath expr="//h2" position="replace" mode="inner">
            Trusted by companies like yours.
        </xpath>
    </template>

    <!-- The footer option "Call-to-Action" is an optional view of the main layout. -->
    <template id="template_footer_call_to_action" inherit_id="website.template_footer_call_to_action">
        <xpath expr="//section[hasclass('s_call_to_action')]//h2" position="replace" mode="inner">
            Join the companies that grow their business with us.
        </xpath>
    </template>

    <!-- The account name is the default the website falls back to when it has no Instagram account of its own. -->
    <template id="s_instagram_page" inherit_id="website.s_instagram_page">
        <xpath expr="//section[hasclass('s_instagram_page')]" position="attributes">
            <attribute name="data-instagram-page">officialviindoo</attribute>
        </xpath>
    </template>

    <!-- The Facebook preview shows the Viindoo page until the block takes the page of the website's company. -->
    <template id="s_facebook_page" inherit_id="website.s_facebook_page">
        <xpath expr="//iframe[hasclass('o_facebook_page_preview')]" position="attributes">
            <attribute name="src">https://www.facebook.com/plugins/page.php?height=500&amp;hide_cover=false&amp;href=https%3A%2F%2Fwww.facebook.com%2FViindoo&amp;show_facepile=false&amp;small_header=false&amp;tabs=timeline%2Cevents%2Cmessages&amp;width=500</attribute>
        </xpath>
    </template>

    <template id="s_cta_centered" inherit_id="website.s_cta_centered">
        <xpath expr="//h2" position="replace" mode="inner">
            Join the companies that grow <br/>their business with us.
        </xpath>
    </template>

    <!-- The block picker and the drag ghost show generic feed mockups, not the profile of another company. -->
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//t[@t-snippet='website.s_instagram_page'][@t-image-preview]" position="attributes">
            <attribute name="t-image-preview">/viin_brand_website/static/src/img/s_instagram_preview.webp</attribute>
        </xpath>
        <xpath expr="//t[@t-snippet='website.s_instagram_page'][@t-drag-image-preview]" position="attributes">
            <attribute name="t-drag-image-preview">/viin_brand_website/static/src/img/s_instagram_preview.webp</attribute>
        </xpath>
        <xpath expr="//t[@t-snippet='website.s_facebook_page'][@t-image-preview]" position="attributes">
            <attribute name="t-image-preview">/viin_brand_website/static/src/img/s_facebook_preview.webp</attribute>
        </xpath>
        <xpath expr="//t[@t-snippet='website.s_facebook_page'][@t-drag-image-preview]" position="attributes">
            <attribute name="t-drag-image-preview">/viin_brand_website/static/src/img/s_facebook_preview.webp</attribute>
        </xpath>
    </template>

    <record id="website.s_mega_menu_odoo_menu" model="ir.ui.view">
        <field name="name">Viindoo Menu</field>
    </record>

</odoo>

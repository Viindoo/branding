#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Choosing the product with the longest name"
msgstr "Chọn sản phẩm có tên dài nhất"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Comparing the features of the product with the needs of the customer"
msgstr "So sánh tính năng của sản phẩm với nhu cầu của khách hàng"

#. module: viin_brand_survey
#: model:ir.model.fields,field_description:viin_brand_survey.field_survey_survey__display_name

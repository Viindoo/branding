#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Cheating on your neighbors will not help!"
msgstr "Lừa dối hàng xóm không mang lại lợi lộc gì!"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Choosing the cheapest product whatever it does"
msgstr "Chọn sản phẩm rẻ nhất bất kể nó làm được gì"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Choosing the product with the longest name"
msgstr "Chọn sản phẩm có tên dài nhất"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Comparing the features of the product with the needs of the customer"
msgstr "So sánh tính năng của sản phẩm với nhu cầu của khách hàng"

#. module: viin_brand_survey
#: model:ir.model.fields,field_description:viin_brand_survey.field_survey_survey__display_name
msgid "Display Name"
msgstr "Tên hiển thị"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Find the answer and come back to the customer"
msgstr "Tìm câu trả lời rồi quay lại với khách hàng"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Good luck!"
msgstr "Chúc bạn may mắn!"

#. module: viin_brand_survey
#: model:ir.model.fields,field_description:viin_brand_survey.field_survey_survey__id
msgid "ID"
msgstr ""

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Ignore the question"
msgstr "Bỏ qua câu hỏi"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "It describes the features and the specifications of the product"
msgstr "Mô tả các tính năng và thông số kỹ thuật của sản phẩm"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "It lists the employees who built the product"
msgstr "Liệt kê các nhân viên đã tạo ra sản phẩm"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "It replaces the invoice of the product"
msgstr "Thay thế hóa đơn của sản phẩm"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Make up an answer"
msgstr "Tự bịa ra một câu trả lời"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Product Knowledge Certification"
msgstr "Chứng chỉ Kiến thức sản phẩm"

#. module: viin_brand_survey
#: model:ir.model,name:viin_brand_survey.model_survey_survey
msgid "Survey"
msgstr "Khảo sát"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid ""
"Welcome to this product knowledge certification. You will receive 2 random "
"questions out of a pool of 3."
msgstr ""
"Chào mừng bạn đến với chứng chỉ kiến thức sản phẩm này. Bạn sẽ nhận 2 câu "
"hỏi ngẫu nhiên trong tổng số 3 câu."

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "What is the main purpose of a product datasheet?"
msgstr "Mục đích chính của bảng thông số sản phẩm là gì?"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "What should you do when a customer asks a question you cannot answer?"
msgstr "Bạn nên làm gì khi khách hàng hỏi một câu bạn không thể trả lời?"

#. module: viin_brand_survey
#. odoo-python
#: code:addons/viin_brand_survey/models/survey_survey.py:0
msgid "Which of these helps a customer choose the right product?"
msgstr "Điều nào sau đây giúp khách hàng chọn đúng sản phẩm?"

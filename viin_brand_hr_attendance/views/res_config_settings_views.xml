<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.viin.brand.hr.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='attendance_from_systray']]" position="attributes">
                <attribute name="help">Allow Users to Check in/out from Viindoo.</attribute>
            </xpath>
            <xpath expr="//a[@href='https://www.odoo.com/documentation/latest/applications/hr/attendances/hardware.html']" position="attributes">
                <attribute name="href">https://viindoo.com/documentation/19.0/applications/human-resources/attendances/operations/set-up-the-attendance-kiosk.html</attribute>
            </xpath>
        </field>
    </record>
</odoo>

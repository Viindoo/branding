<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The provider is deleted only when core's record exists: a missing xml id logs a warning -->
    <delete
        model="auth.oauth.provider"
        search="[('id', 'in', obj().env['ir.model.data'].search([('module', '=', 'auth_oauth'), ('name', '=', 'provider_openerp')]).mapped('res_id'))]"/>
</odoo>

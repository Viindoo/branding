<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="card_campaign_view_form" model="ir.ui.view">
        <field name="name">card.campaign.view.form.inherit.viin.brand</field>
        <field name="model">card.campaign</field>
        <field name="inherit_id" ref="marketing_card.card_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">e.g. Annual Customer Talks</attribute>
            </xpath>
            <xpath expr="//field[@name='content_header']" position="attributes">
                <attribute name="placeholder">e.g. Join our Customer Day 2024</attribute>
            </xpath>
        </field>
    </record>

</odoo>

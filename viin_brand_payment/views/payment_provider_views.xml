<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
	    <field name="name">payment.provider.form</field>
	    <field name="model">payment.provider</field>
	    <field name="inherit_id" ref="payment.payment_provider_form"/>
	    <field name="arch" type="xml">
	       <xpath expr="//div[hasclass('oe_title')]/div/a" position="attributes">
	           <attribute name="href">https://viindoo.com/pricing?utm_source=db&amp;utm_medium=module</attribute>
	       </xpath>
	    </field>
	</record>
	
    <record id="payment_provider_kanban" model="ir.ui.view">
	    <field name="name">payment.provider.kanban</field>
	    <field name="model">payment.provider</field>
	    <field name="inherit_id" ref="payment.payment_provider_kanban"/>
	    <field name="arch" type="xml">
	       <xpath expr="//footer/button[@target='_blank']" position="attributes">
	           <attribute name="href">https://viindoo.com/pricing?utm_source=db&amp;utm_medium=module</attribute>
	       </xpath>
	   </field>
	</record>

    <record id="payment_method_form" model="ir.ui.view">
        <field name="name">payment.method.form.inherit.viin.brand</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']/div[hasclass('alert-warning')]" position="replace" mode="inner">
                <i class="oi" data-icon="warning"/> These properties are set to
                match the behavior of providers and that of their integration with
                Viindoo regarding this payment method. Any change may result in errors
                and should be tested on a test database first.
            </xpath>
        </field>
    </record>
</odoo>

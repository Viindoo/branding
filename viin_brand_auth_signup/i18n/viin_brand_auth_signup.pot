#. module: viin_brand_auth_signup
#: model:ir.module.module,summary:base.module_viin_brand_auth_signup
msgid "Debranding Sign Up email templates for Viindoo"
msgstr ""

#. module: viin_brand_auth_signup
#: model:ir.module.module,description:base.module_viin_brand_auth_signup
msgid ""
"\n"
"What it does\n"
"============\n"
"This module replaces Odoo branding with Viindoo in the invitation email sent to a new user and in\n"
"the welcome subtitle of the email sent when an account is created.\n"
"\n"
"Editions Supported\n"
"==================\n"
"1. Community Edition\n"
"2. Enterprise Edition\n"
"\n"
msgstr ""


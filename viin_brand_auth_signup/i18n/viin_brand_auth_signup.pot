#. module: auth_signup
#: model:mail.template,subject:auth_signup.set_password_email
msgid ""
"{{ object.create_uid.name }} from {{ object.company_id.name }} invites you "
"to connect to Viindoo"
msgstr ""

#. module: auth_signup
#: model:mail.template,body_html:auth_signup.set_password_email
msgid ""
"<t>\n"
"<t t-set=\"company_name\" t-value=\"object.company_id.name or ''\"></t>\n"
"<t t-set=\"website_url\" t-value=\"object.get_base_url()\"></t>\n"
"Hi <t t-out=\"object.name or ''\">Marc Demo</t>,<br><br>\n"
"<em>This link is valid for <t t-out=\"(object.env['ir.config_parameter'].sudo().get_int('auth_signup.signup.validity.hours') or 144)//24\">link_validity_days</t> days </em><br>\n"
"<b><t t-out=\"company_name\"></t></b> uses <a href=\"https://viindoo.com\" t-attf-style=\"color: {{object.company_id.email_secondary_color or '#7F4282'}};\">Viindoo</a>\n"
"to run its business. You have been invited by <b><t t-out=\"object.create_uid.name or ''\">ViindooBot</t></b> to connect.\n"
"<br><br>\n"
"Once accepted, you can reconnect through: <br>\n"
"<ul>\n"
"    <li>Login: <a t-attf-href=\"/web/login?login={{ object.email }}\" target=\"_blank\" t-out=\"object.email or ''\">mark.brown23@example.com</a></li>\n"
"    <li>Link: <a t-att-href=\"website_url\" t-out=\"website_url or ''\">http://www.example.com</a></li>\n"
"</ul>\n"
"<br>\n"
"<div style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"object.partner_id._get_signup_url()\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#7F4282'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"        Accept invitation\n"
"    </a>\n"
"</div>\n"
"<br>\n"
"Enjoy Viindoo!<br><br>\n"
"--<br>The <t t-out=\"company_name\"></t> Team</t>\n"
"        "
msgstr ""

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_slide_slide_form" model="ir.ui.view">
        <field name="name">slide.slide.form.inherit.viin.brand</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="placeholder">e.g. In this video, we'll give you the keys on how we can help you to grow your business. At the end, we'll propose you a quiz to test your knowledge.</attribute>
            </xpath>
        </field>
    </record>

</odoo>

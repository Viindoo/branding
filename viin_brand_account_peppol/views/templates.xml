<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Override account_peppol layout: replace Odoo link/text with Viindoo -->
        <template id="mail_notification_layout_with_responsible_signature_and_peppol"
                  inherit_id="account_peppol.mail_notification_layout_with_responsible_signature_and_peppol">
            <!-- Step 1: rewrite href attribute only, preserving all other attributes -->
            <xpath expr="//a[@href='https://www.odoo.com/app/invoicing']" position="attributes">
                <attribute name="href">https://viindoo.com/app/invoicing</attribute>
            </xpath>
            <!-- Step 2: replace inner text only, using updated href as selector -->
            <xpath expr="//a[@href='https://viindoo.com/app/invoicing']" position="replace" mode="inner">Viindoo</xpath>
        </template>

    </data>
</odoo>

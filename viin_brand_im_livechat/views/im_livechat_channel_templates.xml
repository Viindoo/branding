<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="support_page" inherit_id="im_livechat.support_page">
        	<xpath expr="//head/style[@type='text/css'][last()]" position="after">
        		<style type="text/css">
                        body {
                            background-image: linear-gradient(to bottom, #592E5B, #7F4282);
                        }
                    </style>
        	</xpath>
        	<!-- The software that powers the page: the element is kept, only its name changes -->
        	<xpath expr="//body/div[hasclass('main')]/div/strong" position="replace" mode="inner">Viindoo</xpath>
        </template>
    </data>
</odoo>

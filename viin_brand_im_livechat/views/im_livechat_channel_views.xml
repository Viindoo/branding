<odoo>
	<record id="im_livechat_channel_view_form" model="ir.ui.view">
	    <field name="name">im_livechat.channel.form</field>
	    <field name="model">im_livechat.channel</field>
	    <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
	    <field name="priority">110</field>
	    <field name="arch" type="xml">
			<xpath expr="//page[@name='Agents']//p[hasclass('text-muted')]" position="replace" mode="inner">
				Agents who are inactive in Viindoo for more than 30 minutes will be considered disconnected.
			</xpath>
			<xpath expr="//page[@name='configuration_widget']//separator[1]" position="attributes">
				<attribute name="string">FOR WEBSITES BUILT WITH VIINDOO</attribute>
			</xpath>
			<!-- The reset buttons restore the colours the channel is created with. -->
			<xpath expr="//widget[@name='colors_reset_button'][contains(@options, 'button_background_color')]" position="attributes">
				<attribute name="options">{'default_colors': {'button_background_color': '#7F4282', 'button_text_color': '#FFFFFF'}}</attribute>
			</xpath>
			<xpath expr="//widget[@name='colors_reset_button'][contains(@options, 'header_background_color')]" position="attributes">
				<attribute name="options">{'default_colors': {'header_background_color': '#7F4282', 'title_color': '#FFFFFF'}}</attribute>
			</xpath>
	    </field>
	</record>
</odoo>

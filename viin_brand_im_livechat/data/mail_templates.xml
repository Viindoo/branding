<odoo>
    <!-- Rendered straight by ir.qweb, so the colour is read from the company when the transcript is built. -->
    <template id="livechat_email_template" inherit_id="im_livechat.livechat_email_template">
        <!-- sudo: visitor can access header background color -->
        <xpath expr="//t[@t-set='header_background_color']" position="attributes">
            <attribute name="t-value">channel.livechat_channel_id.sudo().header_background_color or company.email_secondary_color or '#7F4282'</attribute>
        </xpath>
        <xpath expr="//strong[@t-out='attachment.mimetype']" position="attributes">
            <attribute name="style"/>
            <attribute name="t-attf-style">background-color: #{company.email_secondary_color or '#7F4282'}; color: #{company.email_primary_color or '#FFFFFF'}; padding: 2px 5px; border-radius: 3px; text-transform: uppercase; font-size: 10px; margin-right: 4px;</attribute>
        </xpath>
    </template>
</odoo>

#. module: mass_mailing
#: model_terms:ir.actions.act_window,help:mass_mailing.action_create_mass_mailings_from_campaign
#: model_terms:ir.actions.act_window,help:mass_mailing.action_view_mass_mailings_from_campaign
msgid ""
"You don't need to import your mailing lists, you can easily\n"
"                send emails<br> to any contact saved in other Viindoo apps."
msgstr ""
"Bạn không cần nhập danh sách liên hệ, bạn có thể dễ dàng\n"
"                gửi email<br> đến bất kỳ liên hệ nào được lưu trong các ứng dụng Viindoo khác."

#. module: mass_mailing
#: model_terms:ir.actions.act_window,help:mass_mailing.action_view_mass_mailing_lists
msgid ""
"No need to import mailing lists, you can send mailings to contacts saved in "
"other Viindoo apps."
msgstr ""
"Không cần nhập danh sách gửi thư, bạn có thể gửi thư cho các liên hệ được lưu trong "
"các ứng dụng Viindoo khác."

#. module: viin_brand_mass_mailing
#: model_terms:ir.ui.view,arch_db:viin_brand_mass_mailing.s_call_to_action
msgid ""
"<font style=\"color: white;\"><strong>Join the companies</strong> that grow "
"their business with us.</font>"
msgstr ""
"<font style=\"color: white;\"><strong>Hãy cùng những doanh nghiệp</strong> "
"đang phát triển kinh doanh với chúng tôi.</font>"


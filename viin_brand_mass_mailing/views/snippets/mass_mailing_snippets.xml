<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_section_mobile" inherit_id="mass_mailing.s_section_mobile">
        <xpath expr="//img[hasclass('o_editable_media')]" position="attributes">
            <attribute name="src">/viin_brand_mass_mailing/static/src/img/mobile-app.png</attribute>
            <attribute name="data-original-src">/viin_brand_mass_mailing/static/src/img/mobile-app.png</attribute>
            <attribute name="alt">Mobile app</attribute>
        </xpath>
        <!-- The store badges stay; their links are placeholders because the app is the customer's own. -->
        <xpath expr="(//a[@target='_blank'])[1]" position="attributes">
            <attribute name="href">#</attribute>
        </xpath>
        <xpath expr="(//a[@target='_blank'])[2]" position="attributes">
            <attribute name="href">#</attribute>
        </xpath>
    </template>

    <template id="s_customer_quote" inherit_id="mass_mailing.s_customer_quote">
        <xpath expr="//img[hasclass('o_editable_media')]" position="attributes">
            <attribute name="data-original-src">/viin_brand_mass_mailing/static/src/img/mobile-app.png</attribute>
        </xpath>
    </template>

    <template id="s_schedule" inherit_id="mass_mailing.s_schedule">
        <xpath expr="(//ul)[1]/li[1]" position="replace" mode="inner">Interactive demo</xpath>
    </template>

</odoo>
